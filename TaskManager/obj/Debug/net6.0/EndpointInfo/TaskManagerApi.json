  "components": {
    "schemas": {
      "CreateJobHeaderDTO": {
        "required": [
          "assignedUserId",
          "deadline",
          "managerId",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "minLength": 10,
            "type": "string"
          },
          "managerId": {
            "type": "integer",
            "format": "int32"
          },
          "assignedUserId": {
            "type": "integer",
            "format": "int32"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CreateUserDto": {
        "required": [
          "email",
          "password",
          "roleId",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 5,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 5,
            "type": "string"
          },
          "roleId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "InsertJobDetailDTO": {
        "required": [
          "detail",
          "headerId",
          "jobDetayStatus",
          "userId"
        ],
        "type": "object",
        "properties": {
          "headerId": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "maxLength": 254,
            "minLength": 10,
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "jobDetayStatus": {
            "$ref": "#/components/schemas/JobDetayStatus"
          }
        },
        "additionalProperties": false
      },
      "InsertOrUpdateRoleDTO": {
        "required": [
          "roleName"
        ],
        "type": "object",
        "properties": {
          "roleName": {
            "minLength": 3,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "JobDetayStatus": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "LoginDTO": {
        "required": [
          "passWord",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 5,
            "type": "string"
          },
          "passWord": {
            "minLength": 5,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateUserDto": {
        "required": [
          "email",
          "password",
          "roleId",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 5,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 5,
            "type": "string"
          },
          "roleId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "updateJobHeaderDTO": {
        "required": [
          "assignedUserId",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "minLength": 10,
            "type": "string"
          },
          "assignedUserId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT Bearer token giriniz. Örnek: Bearer {token}",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
