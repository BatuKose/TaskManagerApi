          }
        },
        "additionalProperties": false
      },
      "CreateUserDto": {
        "required": [
          "email",
          "password",
          "roleId",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 5,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 5,
            "type": "string"
          },
          "roleId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "InsertOrUpdateRoleDTO": {
        "required": [
          "roleName"
        ],
        "type": "object",
        "properties": {
