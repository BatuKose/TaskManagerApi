  "components": {
    "schemas": {
      "CreateJobHeaderDTO": {
        "required": [
          "assignedUserId",
          "deadline",
          "managerId",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "minLength": 10,
            "type": "string"
          },
          "managerId": {
            "type": "integer",
            "format": "int32"
          },
          "assignedUserId": {
            "type": "integer",
